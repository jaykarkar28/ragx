
# ==========================================
# RAGX - Environment Configuration
# ==========================================

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# LLM
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Vector Store
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=experiments/vector_store

# Retrieval
DENSE_TOP_K=10
KEYWORD_TOP_K=10
HYBRID_TOP_K=10
FUSION_METHOD=rrf
RRF_K=60

# Reranking
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
RERANKER_ENABLED=true

# Generation
GENERATION_TOP_K=5

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Evaluation
EVALUATION_K_VALUES=[1,3,5,10]

# Application
LOG_LEVEL=INFO